{
    "rewrites": [
        {
            "source": "/auth/callback",
            "destination": "/index.html"
        },
        {
            "source": "/app/settings",
            "destination": "/index.html"
        },
        {
            "source": "/app/settings/:match*",
            "destination": "/index.html"
        },
        {
            "source": "/(.*)",
            "destination": "/index.html"
        }
    ]
}